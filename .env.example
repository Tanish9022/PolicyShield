# PolicyShield Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── Razorpay (Test Mode ONLY) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook HMAC secret from Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# ─── Google Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
# Local: relative path is fine
DB_PATH=./policyshield.db
# Render: use the persistent disk mount path
# DB_PATH=/var/data/policyshield.db

# ─── Identity defaults (dev / test) ──────────────────────────────
# Must match seeded data in schema.sql. Frontend sends these as
# x-merchant-id / x-customer-id headers (or auth middleware falls back here).
DEV_MERCHANT_ID=merchant_1
DEV_CUSTOMER_ID=cust_demo
