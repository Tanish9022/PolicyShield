{
  "name": "@policyshield/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run",
    "eval:gemini": "tsx src/eval/gemini-eval.ts",
    "eval:benchmark": "tsx src/eval/benchmark.ts",
    "eval:redteam": "vitest run --testNamePattern='redteam'",
    "eval:ci": "tsx src/eval/ci-assert.ts",
    "eval:business": "tsx src/eval/business-value-experiment.ts",
    "eval:report": "tsx src/eval/generate-final-report.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@policyshield/shared": "*",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "razorpay": "^2.9.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^26.4.0",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "seedrandom": "^3.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
